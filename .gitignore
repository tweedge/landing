# Build output
dist/
target/

# Build-time favicon cache (fetched locally, never committed)
assets/favicons/

# Personal configuration: never commit your real hosts, URLs, or secrets.
# Copy config/landing.example.yml to config/landing.yml and edit that.
config/landing.yml
config/*.local.yml

# Rust
target/

# Python (legacy implementation, removed after the Rust port)
__pycache__/
*.py[cod]
.venv/
venv/

# Editor/OS
.DS_Store
.idea/
.vscode/

# Runtime artifacts (normally under XDG state, but ignore strays)
*.log
*.pid
*.har

# Test/tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
